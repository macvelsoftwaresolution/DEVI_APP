# Copy to .env and fill in. Never commit .env or share it in chat/email.
# Secrets are left EMPTY on purpose: in production the server refuses to start
# while a required secret is missing, so a forgotten value cannot go live.
# Generate each secret separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

PORT=5005
# development | production
NODE_ENV=

# Database Configuration (Supabase)
SUPABASE_URL=
# SECRET key (sb_secret_… or legacy service_role), never the publishable/anon key.
# Server only: never put it in the app, the dashboard or git. RLS blocks every other key (db/rls.sql).
SUPABASE_KEY=

# Security & Authentication Secrets (required in production, 32+ random characters each)
# Every secret must be DIFFERENT (production refuses to start if two are the same).
# App user login tokens. Changing it logs every app user out.
JWT_SECRET=
# Dashboard login tokens. Changing it logs admins out (they sign in again).
ADMIN_JWT_SECRET=
# SOS control tokens + guardian tracking link keys (?k=). Changing it breaks links already sent.
SOS_LINK_SECRET=
# x-admin-key header for server scripts
ADMIN_SECRET_KEY=
# Database field encryption key (AES-256-GCM).
# Use the SAME value everywhere that connects to the same database. Never just replace it:
# change it with the key rotation steps below, or old data becomes unreadable.
ENCRYPTION_KEY=
# Name of ENCRYPTION_KEY, stored with every value (letters/digits, e.g. 1, 2, 2027a)
ENCRYPTION_KEY_ID=1
# Key rotation: move the old key here as "<old id>:<old secret>" (comma-separated), give
# ENCRYPTION_KEY a new secret + new ENCRYPTION_KEY_ID, restart, run `npm run rotate:key -- --apply`,
# then remove the old key from this list. Old keys are only used to read.
ENCRYPTION_OLD_KEYS=
# Older enc:v1 values (not bound to their row) are read while this is true (default).
# After `npm run rotate:key -- --apply` reports nothing left, set it to false and restart.
ENCRYPTION_ALLOW_V1=true

# Admin Dashboard Login (required in production; avoid "admin" as the username)
# Only the password HASH is stored. Create it with: npm run admin:hash
# A new hash logs every open admin session out.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# 2FA for this login: the authenticator setup key from `npm run admin:2fa`. Set, sign in needs
# the password and the 6-digit code from the app. A new key logs every admin session out.
ADMIN_TOTP_SECRET=
# That login is shared and has no 2FA. Give each operator an account with password + authenticator
# code instead: npm run admin:user -- create <name> (needs db/login-security.sql). When every operator
# has one, set this to off: the shared login and its open sessions stop working.
ADMIN_ENV_LOGIN=on

# Web addresses
# Guardian tracking page (WhatsApp links point here)
WEB_BASE_URL=
# Public address of this API, used to build protected evidence links
API_BASE_URL=
# Optional: extra browser origins allowed to call the API (comma separated)
CORS_ORIGINS=

# WhatsApp Cloud API (Meta) - use a permanent System User token, not a 24-hour test token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved SOS template, Utility category (Marketing ones are held back by Meta: 131049).
# Body variables: {{name}}, {{name1}}, {{location}}, {{time}}, {{name2}}. Default devi_agent_welcome, en_US.
WHATSAPP_SOS_TEMPLATE=
WHATSAPP_SOS_TEMPLATE_LANG=en_US
# Must match the "Verify token" set in the Meta webhook settings (random string)
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret (Meta app dashboard → App settings → Basic). Webhook events must be signed with it.
WHATSAPP_APP_SECRET=
# Emergency control room number that receives SOS from users without guardians
# Country code + number, no "+" (e.g. 91XXXXXXXXXX)
ADMIN_WHATSAPP=
# On-call person paged (voice call + WhatsApp) when an SOS reaches nobody, retries give up,
# or the WhatsApp token, template or call providers fail. With country code (e.g. +91XXXXXXXXXX).
# Without it those failures only reach the server log.
ONCALL_PHONE=
# Folder for SOS taken while the database is down (encrypted, saved to the database when it is
# back). Default: backend/data/sos-journal. Must survive a deploy and must not be served publicly.
SOS_JOURNAL_DIR=

# Deep health check GET /api/health/deep (database, queue, worker, journal, WhatsApp token,
# Plivo and Twilio balance). Send this in the X-Health-Key header, or log in as admin.
# Random string, e.g. `openssl rand -hex 32`. Without it only an admin login can read it.
HEALTH_CHECK_KEY=
# The monitor pages ONCALL_PHONE when a balance drops below these (account currency). Default: 5.
PLIVO_MIN_BALANCE=
TWILIO_MIN_BALANCE=

# Daily cap on paid SOS sends to UNVERIFIED numbers (Instant SOS, numbers not saved on an account),
# per country, IST day. Saved guardians of a logged-in user are never capped. * = any other country,
# 0 = no cap. Reaching it pages ONCALL_PHONE. Default: IN:1000,*:100
SOS_UNVERIFIED_DAILY_CAP=

# Retention (db/retention.sql): days each kind of data is kept, deleted once a day. 0 = forever.
# Defaults: queue archive 30, WhatsApp statuses 30, sign-in codes 7, SOS send plans 7 (at least 1).
RETENTION_QUEUE_ARCHIVE_DAYS=
RETENTION_WHATSAPP_STATUS_DAYS=
RETENTION_OTP_DAYS=
RETENTION_SEND_PLAN_DAYS=
# SOS history itself, with its press-1 records. 0 (default) keeps it forever: set it only after a
# legal decision on how long SOS records must be kept. Evidence files in Cloudinary are not deleted.
RETENTION_SOS_DAYS=0

# Cloudinary (private evidence video/audio storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Countries open for sign up and guardians (ISO codes, comma separated, or ALL). Default: IN.
# The app lists only these countries; with one open it shows no dropdown.
# Every SOS call and WhatsApp to these countries is paid, so add one only when it is needed.
ALLOWED_COUNTRIES=
# Countries an Instant SOS (no login) may alert. Others need a logged-in user's saved guardians. Default: IN.
GUEST_SOS_COUNTRIES=IN
# Sign up codes per day to numbers outside GUEST_SOS_COUNTRIES. Default: 50.
FOREIGN_OTP_DAILY_LIMIT=50

# Google Maps (server-side reverse geocoding)
GOOGLE_MAPS_API_KEY=

# IVR emergency calls: +91 numbers go through Plivo, with Twilio as backup when Plivo is missing
# or its call fails. Every other country goes through Twilio only: the Plivo account is
# India-region, and Indian telecom rules let it call numbers inside India only.
# Backend address the call providers reach. Not PUBLIC_BASE_URL: that is the web site.
PUBLIC_API_URL=https://devi-api.macvelsoftware.com
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_CALLER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=
# IVR webhooks must be signed by Plivo / Twilio with the auth tokens above.
# log (default): a bad signature is logged, the call still works. enforce: refused with 403.
# Switch to enforce only after real calls show no "[IVR SIGNATURE]" warnings in the log.
# Signatures cover PUBLIC_API_URL, so it must be exactly the address the providers call.
IVR_SIGNATURE_MODE=log
