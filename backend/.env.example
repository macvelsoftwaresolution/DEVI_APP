PORT=5005
NODE_ENV=development

# Database Configuration (Supabase)
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_api_key

# Security & Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
ADMIN_SECRET_KEY=your_admin_operator_secret_key
# Server-only key for database field encryption (AES-256-GCM). 32+ random chars: openssl rand -base64 48
# Use the SAME value everywhere that connects to the same database. Changing it makes old data unreadable.
ENCRYPTION_KEY=generate_a_long_random_secret

# Admin Dashboard Login (required in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use_a_long_random_password

# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Must match the "Verify token" set in the Meta webhook settings (random string)
WHATSAPP_VERIFY_TOKEN=
ADMIN_WHATSAPP=

# Optional: extra browser origins allowed to call the API (comma separated)
CORS_ORIGINS=

# Cloudinary Configuration (Evidence Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Fast2SMS Indian SMS Gateway (High Speed, 100% TRAI Legal)
FAST2SMS_API_KEY=your_fast2sms_api_key
