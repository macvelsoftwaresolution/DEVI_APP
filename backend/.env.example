# Copy to .env and fill in. Never commit .env or share it in chat/email.
# Secrets are left EMPTY on purpose: in production the server refuses to start
# while a required secret is missing, so a forgotten value cannot go live.
# Generate each secret separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

PORT=5005
# development | production
NODE_ENV=

# Database Configuration (Supabase)
SUPABASE_URL=
# SECRET key (sb_secret_… or legacy service_role), never the publishable/anon key.
# Server only: never put it in the app, the dashboard or git. RLS blocks every other key (db/rls.sql).
SUPABASE_KEY=

# Security & Authentication Secrets (required in production, 32+ random characters each)
# JWT_SECRET also signs guardian tracking links: changing it invalidates links already sent.
JWT_SECRET=
ADMIN_SECRET_KEY=
# Database field encryption key (AES-256-GCM).
# Use the SAME value everywhere that connects to the same database. Changing it makes old data unreadable.
ENCRYPTION_KEY=

# Admin Dashboard Login (required in production; avoid "admin" as the username)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Web addresses
# Guardian tracking page (WhatsApp links point here)
WEB_BASE_URL=
# Public address of this API, used to build protected evidence links
API_BASE_URL=
# Optional: extra browser origins allowed to call the API (comma separated)
CORS_ORIGINS=

# WhatsApp Cloud API (Meta) - use a permanent System User token, not a 24-hour test token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Must match the "Verify token" set in the Meta webhook settings (random string)
WHATSAPP_VERIFY_TOKEN=
# Emergency control room number that receives SOS from users without guardians
# Country code + number, no "+" (e.g. 91XXXXXXXXXX)
ADMIN_WHATSAPP=

# Cloudinary (private evidence video/audio storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (server-side reverse geocoding)
GOOGLE_MAPS_API_KEY=
